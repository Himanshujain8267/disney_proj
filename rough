import React, { useEffect, useState } from 'react'
import GlobalApi from '../Services/GlobalApi'
import MovieCard from './MovieCard';

function MovieList({genereId}) {

const [movielist,setmovielist]= useState([]) ;
const getMovieByGenereId = () => {
  if (genereId) {
    GlobalApi.getMovieByGenereId(genereId).then(resp => {
      console.log(resp);
      setmovielist(resp.data.results);
    });
  }
};

useEffect(() => {
  getMovieByGenereId();
}, [genereId]);


// Make the movie list horizontal using flexbox
// Add a container style for horizontal scrolling
  return (
    <div className={"flex scrollbar-hide overflow-x-auto gap-4 py-2"} >
{
movielist.map((item,idx)=>(

<MovieCard movie={item}/>


))
}
    </div>
  )
}

export default MovieList